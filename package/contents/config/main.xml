<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name="plasma-com.github.kobuster.noteshuffle-$plasmoidId-appletsrc"/>

  <group name="General">
    <!-- Sources: Markdown notes, folders of notes, or fortune files (name kept from the original widget) -->
    <entry name="quotesFiles" type="StringList">
      <default>quotes/inspirational_quotes.txt</default>
    </entry>
    <!-- Sources switched off, and folders read without their subfolders -->
    <entry name="disabledSources" type="StringList">
      <default></default>
    </entry>
    <entry name="flatSources" type="StringList">
      <default></default>
    </entry>
    <entry name="vaultPath" type="String">
      <label>Obsidian vault folder, used to find embedded images</label>
      <default></default>
    </entry>
    <entry name="rotationInterval" type="Int">
      <default>120</default>
      <min>10</min>
      <max>86400</max>
    </entry>
    <entry name="rescanInterval" type="Int">
      <label>Minutes between rescans of the sources</label>
      <default>10</default>
      <min>1</min>
      <max>1440</max>
    </entry>
    <entry name="imageMaxHeight" type="Double">
      <label>Largest image height, as a share of the widget height</label>
      <default>0.6</default>
      <min>0.1</min>
      <max>1.0</max>
    </entry>
    <entry name="textAlignment" type="Int">
      <label>0 left, 1 centered, 2 justified</label>
      <default>1</default>
      <min>0</min>
      <max>2</max>
    </entry>
    <!-- Rendering page; the code/pieces.js header lists what each value means -->
    <entry name="showFrontMatter" type="Bool">
      <default>false</default>
    </entry>
    <entry name="tagMode" type="Int">
      <label>0 keep tags, 1 hide lines of only tags, 2 hide all tags</label>
      <default>1</default>
    </entry>
    <entry name="imageMode" type="Int">
      <label>0 first image, 1 all images, 2 no images</label>
      <default>0</default>
    </entry>
    <entry name="titleMode" type="Int">
      <label>0 keep heading, 1 hide heading, 2 file name when there is no heading</label>
      <default>0</default>
    </entry>
    <entry name="lengthMode" type="Int">
      <label>0 whole, 1 first paragraphs, 2 about N characters, 3 up to the cut marker</label>
      <default>0</default>
    </entry>
    <entry name="lengthParagraphs" type="Int">
      <default>3</default>
      <min>1</min>
      <max>100</max>
    </entry>
    <entry name="lengthChars" type="Int">
      <default>600</default>
      <min>50</min>
      <max>20000</max>
    </entry>
    <entry name="cutMarker" type="String">
      <default>%%more%%</default>
    </entry>
    <entry name="obsidianLineBreaks" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showScrollbar" type="Bool">
      <default>true</default>
    </entry>
    <entry name="backgroundOpacity" type="Double">
      <default>0.5</default>
      <min>0.0</min>
      <max>1.0</max>
    </entry>
    <entry name="textFont" type="String">
      <default></default>
    </entry>
    <entry name="textColor" type="Color">
      <default>#FFFFFF</default>
    </entry>
    <entry name="outlineColor" type="Color">
      <default>#000000</default>
    </entry>
    <entry name="backgroundColor" type="Color">
      <default>#000000</default>
    </entry>
    <!-- Which piece is showing, so it survives a Plasma restart -->
    <entry name="lastUpdateTime" type="LongLong">
      <default>0</default>
    </entry>
    <entry name="currentQuoteIndex" type="Int">
      <default>-1</default>
    </entry>
    <entry name="currentQuoteSourceFile" type="String">
      <default></default>
    </entry>
    <entry name="debugMode" type="Bool">
      <label>Enable debug mode logging</label>
      <default>false</default>
    </entry>
  </group>
</kcfg>
